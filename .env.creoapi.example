# ============ .env.creoapi — ПРИМЕР (подставь СВОИ значения) ============
# Файл лежит рядом с think_streaming_lite.py (или на уровень выше).
# НЕ включать в пакет, не коммитить, никому не передавать.

# --- Креденшелы LLM (обязательно; твои, а не мои) ---
AUTH_EMAIL=api.ops.power.bi.reports.noreply@pmru.com
AUTH_PASSWORD=RnvnPc9C

# --- Порт прокси (дашборд и пилюля ходят сюда) ---
PROXY_PORT=8081
# PROXY_HOST=127.0.0.1            ; по умолчанию, только локально

# --- Квота, которую показывает дашборд (рекомендуемые значения) ---
HOURLY_TOKEN_QUOTA=40000000      ; токенов на окно
TOKEN_WINDOW_SECONDS=18000       ; окно в секундах (18000 = 5 часов)

